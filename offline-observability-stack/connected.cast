[0.545, "o", "\b\u001b[0m \b\u001b[?2004l\r\r\n"]
[0.009, "o", "kind: ZarfPackageConfig\r\nmetadata:\r\n  name: monitoring-stack\r\n  description: Offline version of Telemetry Forge example monitoring stack\r\n  authors: Patrick Stephens <pat@telemetryforge.io>\r\n  version: 2026.11.05\r\ncomponents:\r\n  - name: examples-repository\r\n    description: \"A repository of example configurations for Fluent Bit\"\r\n    repos:\r\n      - https://github.com/telemetryforge/fluent-bit-examples.git\r\n    # Triggers a disconnected failure as missing gitea unless you do\r\n    # zarf init --components=git-server\r\n    required: false\r\n  - name: kube-prometheus-stack\r\n    description: \"A collection of Kubernetes manifests, Grafana dashboards, and Prometheus rules combined with documentation and scripts to provide easy to operate end-to-end Kubernetes cluster monitoring with Prometheus using the Prometheus Operator.\"\r\n    required: true\r\n    charts:\r\n      - name: kube-prometheus-stack-oci\r\n        url: oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack\r\n        version: 78.2.1\r\n        namespace"]
[0.001, "o", ": monitoring\r\n        releaseName: kube-prom-stack\r\n    images:\r\n      # docker exec -it $(kind get clusters | head -1)-control-plane crictl images\r\n      # zarf dev find-images\r\n      - docker.io/bats/bats:v1.4.1\r\n      - docker.io/grafana/grafana:12.2.0\r\n      - quay.io/kiwigrid/k8s-sidecar:1.30.10\r\n      - quay.io/prometheus-operator/prometheus-operator:v0.86.0\r\n      - quay.io/prometheus/node-exporter:v1.9.1\r\n      - registry.k8s.io/ingress-nginx/kube-webhook-certgen:v1.6.3\r\n      - registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.17.0\r\n      # Possible images - kube-prometheus-stack\r\n      - quay.io/prometheus-operator/prometheus-config-reloader:v0.86.0\r\n      - quay.io/prometheus/alertmanager:v0.28.1\r\n      - quay.io/prometheus/prometheus:v3.6.0\r\n      - quay.io/thanos/thanos:v0.39.2\r\n      # Cosign artifacts for images - kube-prometheus-stack\r\n      - quay.io/prometheus-operator/prometheus-operator:sha256-bbd4ff793b3677369005d2c167e5bba362ed31e4ad5f7a0085bdea2e84200c41.sig\r\n      - registry.k8s"]
[0.000, "o", ".io/ingress-nginx/kube-webhook-certgen:sha256-3d671cf20a35cd94efc5dcd484970779eb21e7938c98fbc3673693b8a117cf39.sig\r\n      - registry.k8s.io/kube-state-metrics/kube-state-metrics:sha256-2bbc915567334b13632bf62c0a97084aff72a36e13c4dabd5f2f11c898c5bacd.sig\r\n      - quay.io/prometheus-operator/prometheus-config-reloader:sha256-a1ccf041f1abe8fecb7985964f5488019bdbeed6d3a88ede855cf69a8c374abb.sig\r\n    manifests:\r\n      - name: connect-services\r\n        namespace: monitoring\r\n        files:\r\n          - zarf-connect-services.yaml\r\n  - name: fluent-bit\r\n    description: \"A lightweight and high-performance log processor and forwarder\"\r\n    required: true\r\n    charts:\r\n      - name: fluent-bit-forwarder\r\n        url: https://fluent.github.io/helm-charts\r\n        version: 0.54.0\r\n        namespace: monitoring\r\n        repoName: fluent-bit\r\n        releaseName: fluent-bit-forwarder\r\n        valuesFiles:\r\n          - values-ds.yaml\r\n      - name: fluent-bit-aggregator\r\n        url: https://fluent.github.io/helm-charts\r\n  "]
[0.000, "o", "      version: 0.54.0\r\n        namespace: monitoring\r\n        repoName: fluent-bit\r\n        releaseName: fluent-bit-aggregator\r\n        valuesFiles:\r\n          - values-aggregator.yaml\r\n    images:\r\n      - busybox:latest\r\n      - cr.fluentbit.io/fluent/fluent-bit:4.1.0\r\n      - ghcr.io/telemetryforge/agent:25.10.2\r\n      # Cosign artifacts for images - fluent-bit\r\n      - cr.fluentbit.io/fluent/fluent-bit:sha256-4d2d8b84bb33b1a641ecd03904c4c610ce374819546cc175bf88025a1c1683e2.sig\r\n"]
